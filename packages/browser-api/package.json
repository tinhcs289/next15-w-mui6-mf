{
  "name": "@packages/browser-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./cookie-item": "./src/cookie-item/index.ts",
    "./cookie-item/adapters/*": "./src/cookie-item/adapters/*.ts",
    "./local-storage-item": "./src/local-storage-item/index.ts",
    "./local-storage-item/adapters/*": "./src/local-storage-item/adapters/*.ts",
    "./sse-client": "./src/sse-client/index.ts",
    "./http-client": "./src/http-client/index.ts"
  },
  "typesVersions": {
    "*": {
      "local-storage-item": [
        "./src/local-storage-item/index.ts"
      ],
      "local-storage-item/adapters/*": [
        "./src/local-storage/adapters/*.ts"
      ],
      "cookie-item": [
        "./src/cookie-item/index.ts"
      ],
      "cookie-item/adapters/*": [
        "./src/cookie/adapters/*.ts"
      ],
      "sse-client": [
        "./src/sse-client/index.ts"
      ],
      "http-client": [
        "./src/http-client/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/index.ts\" \"src/local-storage-item/adapters/*.ts\" \"src/cookie-item/adapters/*.ts\" --format esm,cjs --dts --sourcemap",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "eventsource": ">=2.0.2 <5.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "zod": "^3.22.0 || ^4.0.0",
    "yup": "^0.32.0 || ^1.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@turbo/gen": "2.9.14",
    "@types/express": "5.0.6",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/ui": "4.1.6",
    "eventsource": "4.1.0",
    "express": "5.2.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "yup": "1.7.1",
    "zod": "4.4.3"
  }
}
