{
  "name": "@packages/utils",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./array/*": "./src/array/*.ts",
    "./async/*": "./src/async/*.ts",
    "./common/*": "./src/common/*.ts",
    "./crypt/*": "./src/crypt/*.ts",
    "./data-validate/*": "./src/data-validate/*.ts",
    "./file/*": "./src/file/*.ts",
    "./moment/*": "./src/moment/*.ts",
    "./string/*": "./src/string/*.ts"
  },
  "typesVersions": {
    "*": {
      "array/*": [
        "./src/array/*.ts"
      ],
      "async/*": [
        "./src/async/*.ts"
      ],
      "common/*": [
        "./src/common/*.ts"
      ],
      "crypt/*": [
        "./src/crypt/*.ts"
      ],
      "data-validate/*": [
        "./src/data-validate/*.ts"
      ],
      "file/*": [
        "./src/file/*.ts"
      ],
      "moment/*": [
        "./src/moment/*.ts"
      ],
      "string/*": [
        "./src/string/*.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/*.ts\" --format esm,cjs --dts --sourcemap",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "axios": "^1.3.0",
    "crypto-js": "^4.1.0 || ^4.2.0",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.0",
    "moment": "^2.29.0 || ^2.30.0",
    "numeral": "^2.0.0",
    "qs": "^6.10.0 || ^6.12.0",
    "yup": "^0.32.0 || ^1.0.0"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@turbo/gen": "2.9.14",
    "@types/crypto-js": "4.2.2",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash": "4.17.24",
    "@types/node": "25.8.0",
    "@types/numeral": "2.0.5",
    "@types/qs": "6.15.1",
    "@vitest/ui": "4.1.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6",
    "yup": "1.7.1"
  }
}
