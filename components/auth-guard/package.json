{
  "name": "@packages/auth-guard",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/index.ts\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/auth": "workspace:*",
    "@packages/navigation": "workspace:*",
    "@packages/server-actions": "workspace:*",
    "@packages/utils": "workspace:*",
    "next-intl": "4.12.0",
    "react": "19.2.6"
  },
  "devDependencies": {
    "@turbo/gen": "2.9.14",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
