{
  "name": "@shared/form",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./inputs/*": "./src/inputs/*.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/index.ts"
      ],
      "inputs/*": [
        "./src/inputs/*.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/index.ts\" \"src/inputs/*\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@shared/constants": "workspace:*",
    "@shared/states-context": "workspace:*",
    "@shared/typo": "workspace:*",
    "@shared/utils": "workspace:*",
    "@date-io/moment": "3.2.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.4",
    "@mui/material": "7.3.4",
    "@mui/material-nextjs": "7.3.3",
    "@mui/system": "7.3.3",
    "@mui/utils": "7.3.3",
    "@mui/x-date-pickers": "8.16.0",
    "@uidotdev/usehooks": "2.4.1",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "next": "16.0.1",
    "numeral": "2.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0",
    "react-number-format": "5.4.4"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@turbo/gen": "2.5.8",
    "@types/lodash": "4.17.20",
    "@types/node": "24.9.2",
    "@types/numeral": "2.0.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3"
  }
}
