{
  "name": "@shared/form",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./inputs/*": "./src/export-inputs/*.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/index.ts"
      ],
      "inputs/*": [
        "./src/inputs/*.ts"
      ],
      "text": [
        "./src/components/text/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/index.ts\" \"src/export-inputs/*\" \"src/components/text/*.tsx\" \"!src/**/*.test.ts\" \"!src/**/*.test.tsx\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@date-io/moment": ">=3.0.0 <4.0.0",
    "@emotion/cache": ">=11.0.0 <12.0.0",
    "@emotion/react": ">=11.0.0 <12.0.0",
    "@emotion/styled": ">=11.0.0 <12.0.0",
    "@mui/icons-material": ">=7.0.0 <8.0.0",
    "@mui/material": ">=7.0.0 <8.0.0",
    "@mui/material-nextjs": ">=7.0.0 <8.0.0",
    "@mui/system": ">=7.0.0 <8.0.0",
    "@mui/utils": ">=7.0.0 <8.0.0",
    "@mui/x-date-pickers": ">=8.0.0 <9.0.0",
    "@tanstack/react-query": ">=5.90.0 <6.0.0",
    "lodash": "^4.17.0",
    "moment": "^2.24.0",
    "numeral": ">=1.0.0 <3.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "react-hook-form": ">=7.0.0 <9.0.0",
    "react-number-format": "^5.0.0"
  },
  "dependencies": {
    "@packages/states-context": "workspace:*",
    "@shared/typo": "workspace:*",
    "@packages/utils": "workspace:*"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@date-io/moment": "3.2.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "7.3.6",
    "@mui/material": "7.3.6",
    "@mui/material-nextjs": "7.3.6",
    "@mui/system": "7.3.6",
    "@mui/utils": "7.3.6",
    "@mui/x-date-pickers": "8.22.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@turbo/gen": "2.7.1",
    "@types/lodash": "4.17.21",
    "@types/node": "25.0.3",
    "@types/numeral": "2.0.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "@vitest/ui": "4.0.16",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "numeral": "2.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.69.0",
    "react-number-format": "5.4.4",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  }
}
