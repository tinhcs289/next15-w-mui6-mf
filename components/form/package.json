{
  "name": "@shared/form",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./inputs/*": "./src/export-inputs/*.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/index.ts"
      ],
      "inputs/*": [
        "./src/inputs/*.ts"
      ],
      "text": [
        "./src/components/text/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/index.ts\" \"src/export-inputs/*\" \"src/components/text/*.tsx\" \"!src/**/*.test.ts\" \"!src/**/*.test.tsx\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@date-io/moment": ">=3.0.0 <4.0.0",
    "@emotion/cache": ">=11.0.0 <12.0.0",
    "@emotion/react": ">=11.0.0 <12.0.0",
    "@emotion/styled": ">=11.0.0 <12.0.0",
    "@mui/icons-material": ">=7.0.0 <10.0.0",
    "@mui/material": ">=7.0.0 <10.0.0",
    "@mui/material-nextjs": ">=7.0.0 <10.0.0",
    "@mui/system": ">=7.0.0 <10.0.0",
    "@mui/utils": ">=7.0.0 <10.0.0",
    "@mui/x-date-pickers": ">=8.0.0 <9.0.0",
    "@tanstack/react-query": ">=5.90.0 <6.0.0",
    "lodash": "^4.17.0",
    "moment": "^2.24.0",
    "numeral": ">=1.0.0 <3.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0",
    "react-hook-form": ">=7.0.0 <9.0.0",
    "react-number-format": "^5.0.0"
  },
  "dependencies": {
    "@packages/states-context": "workspace:*",
    "@shared/typo": "workspace:*",
    "@packages/utils": "workspace:*"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@date-io/moment": "3.2.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@mui/system": "9.0.1",
    "@mui/utils": "9.0.1",
    "@mui/x-date-pickers": "9.2.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@testing-library/user-event": "14.6.1",
    "@turbo/gen": "2.9.14",
    "@types/lodash": "4.17.24",
    "@types/node": "25.8.0",
    "@types/numeral": "2.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/ui": "4.1.6",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "numeral": "2.0.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.0",
    "react-number-format": "5.4.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  }
}
