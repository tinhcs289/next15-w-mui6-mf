{
  "name": "@shared/layouts",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/index.ts\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@packages/aos": "workspace:*",
    "@shared/constants": "workspace:*",
    "@packages/navigation": "workspace:*",
    "@packages/states-context":  "workspace:*",
    "@packages/use-watch-element-dimensions": "workspace:*",
    "@packages/utils": "workspace:*",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@mui/system": "9.0.1",
    "@mui/utils": "9.0.1",
    "@mui/x-date-pickers": "9.2.0",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@turbo/gen": "2.9.14",
    "@types/lodash": "4.17.24",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
