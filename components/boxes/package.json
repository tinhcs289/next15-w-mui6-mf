{
  "name": "@shared/boxes",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/index.ts\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@mui/system": "9.0.1",
    "@mui/utils": "9.0.1",
    "lodash": "4.18.1",
    "react": "19.2.6",
    "react-lazy-load-image-component": "1.6.3"
  },
  "devDependencies": {
    "@turbo/gen": "2.9.14",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-lazy-load-image-component": "1.6.5",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}
