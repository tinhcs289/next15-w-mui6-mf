{
  "name": "@shared/providers",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./*": "./src/*/index.ts"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./src/*/index.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist && rm -rf .turbo && rm -rf node_modules",
    "build": "tsup \"src/*/index.ts\" --format esm,cjs --dts --sourcemap --external react",
    "lint": "TIMING=1 eslint \"**/*.{ts,tsx,js,jsx}\" --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "@date-io/moment": ">=3.0.0 <4.0.0",
    "@emotion/cache": ">=11.0.0 <12.0.0",
    "@emotion/react": ">=11.0.0 <12.0.0",
    "@emotion/styled": ">=11.0.0 <12.0.0",
    "@mui/icons-material": ">=7.0.0 <10.0.0",
    "@mui/material": ">=7.0.0 <10.0.0",
    "@mui/material-nextjs": ">=7.0.0 <10.0.0",
    "@mui/system": ">=7.0.0 <10.0.0",
    "@mui/utils": ">=7.0.0 <10.0.0",
    "@mui/x-date-pickers": ">=8.0.0 <9.0.0",
    "@tanstack/react-query": ">=5.90.0 <6.0.0",
    "moment": "^2.24.0",
    "notistack": ">=3.0.0 <4.0.0",
    "numeral": ">=1.0.0 <3.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "devDependencies": {
    "@date-io/moment": "3.2.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.0.1",
    "@mui/material": "9.0.1",
    "@mui/material-nextjs": "9.0.1",
    "@mui/system": "9.0.1",
    "@mui/utils": "9.0.1",
    "@mui/x-date-pickers": "9.2.0",
    "@shared/types": "workspace:*",
    "@turbo/gen": "2.9.14",
    "@types/node": "25.8.0",
    "@types/numeral": "2.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tanstack/react-query": "5.100.10",
    "moment": "2.30.1",
    "notistack": "3.0.2",
    "numeral": "2.0.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  }
}