{
  "name": "@app/blog",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "rm -rf .next && rm -rf .turbo && rm -rf node_modules",
    "build": "env-cmd -f ./env/.env.localhost next build",
    "build:development": "env-cmd -f ./env/.env.development next build",
    "build:staging": "env-cmd -f ./env/.env.staging next build",
    "build:production": "env-cmd -f ./env/.env.production next build",
    "dev": "env-cmd -f ./env/.env.localhost next dev --turbopack",
    "dev:development": "env-cmd -f ./env/.env.development next dev --turbopack",
    "dev:staging": "env-cmd -f ./env/.env.staging next dev --turbopack",
    "dev:production": "env-cmd -f ./env/.env.production next dev --turbopack",
    "start": "env-cmd -f ./env/.env.localhost node server.cjs",
    "start:development": "env-cmd -f ./env/.env.development node server.cjs",
    "start:staging": "env-cmd -f ./env/.env.staging node server.cjs",
    "start:production": "env-cmd -f ./env/.env.production node server.cjs",
    "lint": "next lint --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@shared/animate-on-scroll": "workspace:*",
    "@shared/auth": "workspace:*",
    "@shared/auth-guard": "workspace:*",
    "@shared/buttons": "workspace:*",
    "@shared/browser-storage": "workspace:*",
    "@shared/constants": "workspace:*",
    "@shared/data-table": "workspace:*",
    "@shared/form": "workspace:*",
    "@shared/http-client": "workspace:*",
    "@shared/layouts": "workspace:*",
    "@shared/navigation": "workspace:*",
    "@shared/paginated-list": "workspace:*",
    "@shared/providers": "workspace:*",
    "@shared/server-actions": "workspace:*",
    "@shared/stack-next-middleware": "workspace:*",
    "@shared/states-context": "workspace:*",
    "@shared/svg": "workspace:*",
    "@shared/typo": "workspace:*",
    "@shared/utils": "workspace:*",
    "@mui/icons-material": "7.3.4",
    "@mui/material": "7.3.4",
    "@mui/system": "7.3.3",
    "@mui/utils": "7.3.3",
    "@next/third-parties": "16.0.1",
    "@uidotdev/usehooks": "2.4.1",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "next": "16.0.1",
    "next-intl": "4.4.0",
    "notistack": "3.0.2",
    "numeral": "2.0.6",
    "qs": "6.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.65.0"
  },
  "devDependencies": {
    "@shared/types": "workspace:*",
    "@types/lodash": "4.17.20",
    "@types/node": "24.9.2",
    "@types/numeral": "2.0.5",
    "@types/qs": "6.14.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "cross-env": "10.1.0",
    "env-cmd": "11.0.0",
    "typescript": "5.9.3"
  }
}